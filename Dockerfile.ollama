FROM ollama/ollama:latest

ARG OLLAMA_MODEL=qwen2.5:1.5b-instruct

ENV OLLAMA_HOST=0.0.0.0:11434 \
    OLLAMA_MODEL=${OLLAMA_MODEL}

EXPOSE 11434

HEALTHCHECK --interval=10s --timeout=5s --start-period=10m --retries=12 \
    CMD OLLAMA_HOST=http://127.0.0.1:11434 ollama show "$OLLAMA_MODEL" >/dev/null || exit 1

ENTRYPOINT ["/bin/sh", "-c"]
CMD ["set -eu; ollama serve & server_pid=$!; trap 'kill \"$server_pid\" 2>/dev/null || true' EXIT INT TERM; until OLLAMA_HOST=http://127.0.0.1:11434 ollama list >/dev/null 2>&1; do kill -0 \"$server_pid\" 2>/dev/null || exit 1; sleep 1; done; if ! OLLAMA_HOST=http://127.0.0.1:11434 ollama show \"$OLLAMA_MODEL\" >/dev/null 2>&1; then OLLAMA_HOST=http://127.0.0.1:11434 ollama pull \"$OLLAMA_MODEL\"; fi; wait \"$server_pid\""]
